  );
};
```

## ⚠️ 关键代码逻辑

### 避免对象引用共享错误
```typescript
// ❌ 错误：多个属性指向同一对象引用
const createCounters = () => {
  const initialState = { count: 0 };
  return {
    success: initialState,
    error: initialState // 错误：修改一个会影响另一个
  };
};

// ✅ 正确：每个属性独立的对象
const createCounters = () => ({
  success: { count: 0 },
  error: { count: 0 }
});

// ✅ 或使用工厂函数
const createInitialState = () => ({ count: 0 });
const createCounters = () => ({
  success: createInitialState(),
  error: createInitialState()
});
```

### 安全的异步操作
```typescript
// ✅ 完善的异步错误处理
const fetchUserData = async (userId: string): Promise<User | null> => {
  try {
    const response = await fetch(`/api/users/${userId}`);
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
    return await response.json();
  } catch (error) {
    console.error('获取用户数据失败:', error);
    return null;
  }
};

// ✅ React中的副作用清理
const DataFetcher: React.FC = () => {
  useEffect(() => {
    const timer = setInterval(() => { /* ... */ }, 1000);
    return () => clearInterval(timer); // 清理函数
  }, []);
  
  return <div>...</div>;
};
```

### 防止无限循环和递归溢出
```typescript
// ✅ 安全的递归函数
const traverseTreeSafely = (node: TreeNode, depth: number = 0): void => {
  // 防止栈溢出的深度限制
  if (depth > 1000) {
    console.warn('达到最大深度限制');
    return;
  }
  
  // 处理当前节点
  processNode(node);
  
  // 安全地遍历子节点
  node.children?.forEach(child => 
    traverseTreeSafely(child, depth + 1)
  );
};

// ✅ 使用内置方法避免手动循环控制
const findUserById = (users: User[], targetId: string): User | null => {
  return users.find(user => user.id === targetId) || null;
};
```

## 🎨 UI组件规范

### Antd组件使用
- **优先使用Antd组件**完成页面效果，避免重复造轮子
- **合理配置Antd组件属性**，充分利用组件的功能特性
- **统一使用Antd的设计规范**，保持界面一致性

```typescript
// ✅ 合理使用Antd组件
import { Button, List, Typography, notification } from 'antd';

const UserManagement: React.FC = () => {
  const handleDelete = () => {
    notification.warning({
      message: '提示',
      description: '确定要删除该用户吗？',
    });
  };

  return (
    <List
      header={<Typography.Title level={4}>用户列表</Typography.Title>}
      dataSource={users}
      renderItem={(user) => (
        <List.Item actions={[<Button onClick={handleDelete}>删除</Button>]}>
          <Typography.Text strong>{user.name}</Typography.Text>
        </List.Item>
      )}
    />
  );
};
```

## ⚡ 性能最佳实践

### React性能优化
```typescript
// ✅ 使用React.memo和hooks优化性能
const UserCard = React.memo<UserCardProps>(({ user, onEdit }) => {
  const handleEdit = useCallback(() => onEdit(user.id), [user.id, onEdit]);
  const displayName = useMemo(() => 
    `${user.firstName} ${user.lastName}`.trim(),
    [user.firstName, user.lastName]
  );
  
  return (
    <div className={lessModule.userCard}>
      <span>{displayName}</span>
      <button onClick={handleEdit}>编辑</button>
    </div>
  );
});
```

### 内存管理
```typescript
// ✅ 正确清理定时器防止内存泄漏
useEffect(() => {
  const timer = setInterval(() => setTime(prev => prev + 1), 1000);
  return () => clearInterval(timer);
}, []);
```

